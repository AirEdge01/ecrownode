<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up Page</title>
  <style>
    * { box-sizing: border-box; font-family: Arial, sans-serif; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #6a11cb, #2575fc);
      color: #333;
    }
    .container {
      width: min(92vw, 480px);
      background: #fff;
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }
    h1 { margin-top: 0; }
    .input-box { margin-bottom: 16px; }
    .input-box input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #ccc;
      border-radius: 8px;
      outline: none;
    }
    .input-box input:focus { border-color: #2575fc; }
    .btn {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 8px;
      background: linear-gradient(90deg, #6a11cb, #2575fc);
      color: #fff;
      cursor: pointer;
      font-weight: 600;
    }
    .login-text { margin-top: 16px; text-align: center; }
    .login-text a { color: #2575fc; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Create Account</h1>
    <p>Join us and start your journey today.</p>

    <form action="/user/signup" method="post">
      <div class="input-box">
        <input type="text" name="firstName" placeholder="First Name" required />
      </div>
      <div class="input-box">
        <input type="text" name="lastName" placeholder="Last Name" required />
      </div>
      <div class="input-box">
        <input type="email" name="email" placeholder="Email Address" required />
      </div>
      <div class="input-box">
        <input type="password" name="password" placeholder="Password" required />
      </div>
      <button type="submit" class="btn">Sign Up</button>
      <p class="login-text">Already have an account? <a href="/user/signin">Login</a></p>
    </form>
  </div>
</body>
</html>
